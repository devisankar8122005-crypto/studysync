@{ ViewData["Title"] = "Progress"; var subjects = (IEnumerable<dynamic>)ViewBag.Subjects; }
<div class="page-head"><div><h1>Progress</h1><p>See how consistently you are completing your study tasks.</p></div></div>
<div class="stats-grid"><div class="stat-card"><div class="icon blue">📋</div><div><span>Total Tasks</span><strong>@ViewBag.Total</strong></div></div><div class="stat-card"><div class="icon green">✓</div><div><span>Completed</span><strong>@ViewBag.Completed</strong></div></div><div class="stat-card"><div class="icon orange">⏳</div><div><span>Pending</span><strong>@ViewBag.Pending</strong></div></div><div class="stat-card"><div class="icon purple">📈</div><div><span>Overall</span><strong>@ViewBag.Progress%</strong></div></div></div>
<div class="panel"><h3>Subject-wise Progress</h3>@foreach(var s in subjects){var pct=s.Total==0?0:(int)Math.Round(s.Completed*100.0/s.Total);<div class="progress-item"><div><b>@s.Name</b><span>@s.Completed / @s.Total</span></div><div class="bar"><i style="width:@pct%"></i></div><small>@pct%</small></div>}</div>
